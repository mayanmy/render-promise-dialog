{
  "name": "render-promise-dialog",
  "version": "0.2.0",
  "description": "Type-safe promise-based dialog manager for Vue 2 and Vue 3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayanmy/vue-render-promise.git"
  },
  "homepage": "https://github.com/mayanmy/vue-render-promise#readme",
  "bugs": {
    "url": "https://github.com/mayanmy/vue-render-promise/issues"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vue2": {
      "types": "./dist/vue2.d.ts",
      "import": "./dist/vue2.js",
      "require": "./dist/vue2.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "build": "npm run typecheck && vite build -c vite.lib.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test && npm run build"
  },
  "peerDependencies": {
    "vue": "^2.6.14 || ^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^24.2.1",
    "@vue/tsconfig": "^0.8.1",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4",
    "vue": "^3.5.18",
    "vue-tsc": "^3.0.5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "vue",
    "vue2",
    "vue3",
    "dialog",
    "modal",
    "promise",
    "typescript"
  ]
}
